{
  "name": "@syl/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Syl's Node service: the Claude Code harness, stores, jobs and HTTP/WebSocket surface.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@syl/shared": "*",
    "express": "^5.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ws": "^8.5.13"
  }
}
