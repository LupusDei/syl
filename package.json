{
  "name": "syl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Syl — a personal assistant harness driving Claude Code over its native stream-json stdio protocol.",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "pretypecheck": "npm run check:node",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "prebuild": "npm run check:node",
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run check:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "npm run check:node",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm test",
    "mock": "tsx shared/src/cli/mock.ts",
    "contract:generate": "tsx shared/src/cli/generate.ts",
    "ping": "tsx backend/src/harness/cli/ping.ts",
    "when": "tsx backend/src/harness/cli/when.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
