{
  "name": "syl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Syl — a personal assistant harness driving Claude Code over its native stream-json stdio protocol.",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "check:deps": "node scripts/check-workspace-deps.mjs",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check:env": "npm run check:node && npm run check:deps && npm run check:secrets",
    "pretypecheck": "npm run check:env",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "prebuild": "npm run check:env",
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run check:env",
    "test": "vitest run",
    "test:gate": "vitest run --reporter=default --reporter=json --outputFile.json=tests/.vitest-results.json; node scripts/check-expected-failures.mjs",
    "test:watch": "vitest",
    "pretest:coverage": "npm run check:env",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test:gate",
    "premock": "npm run check:env",
    "mock": "tsx shared/src/cli/mock.ts",
    "contract:generate": "tsx shared/src/cli/generate.ts",
    "preping": "npm run check:env",
    "ping": "tsx backend/src/harness/cli/ping.ts",
    "when": "tsx backend/src/harness/cli/when.ts",
    "prepair": "npm run check:env",
    "pair": "tsx backend/src/ops/cli/pair.ts",
    "prelogs": "npm run check:env",
    "logs": "tsx backend/src/ops/cli/logs.ts",
    "prelaunchd": "npm run check:env",
    "launchd": "tsx backend/src/ops/cli/launchd.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
